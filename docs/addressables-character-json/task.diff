diff --git "a/D:\\GIthub\\UnityFight_Portfolio\\Client\\1_backup\\Assets\\_Project\\Scripts\\Manager\\LoadManager.CharacterJsonAddressables.cs" "b/D:\\GIthub\\UnityFight_Portfolio\\Client\\1_backup\\Assets\\_Project\\Scripts\\Manager\\LoadManager.CharacterJsonAddressables.cs"
